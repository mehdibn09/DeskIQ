# ------------------------------------------------------------
# NovaDesk environment variables
# Copy this file to `.env.local` and fill in your values.
# `.env.local` is git-ignored - never commit real secrets.
#
# For Vercel, set the same variables in the project dashboard
# (Settings -> Environment Variables) for Production and Preview.
# ------------------------------------------------------------

# --- Supabase (public, safe to expose to the browser) --------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- App URL (public) ----------------------------------------
# Canonical site URL used for SEO metadata (og:url, canonical).
# On Vercel this is your deployment URL, e.g.
# https://novadesk-xxxxx.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (server only - NEVER expose with NEXT_PUBLIC_) -
# Used exclusively for admin operations: deleting users, deleting other
# people's documents. Service role key from Project Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional -------------------------------------------------
# Secret used to sign the demo-mode session cookie when running
# without Supabase credentials. Any long random string works.
# Not used when the Supabase variables above are configured.
DEMO_SESSION_SECRET=replace-with-a-long-random-string
